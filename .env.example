# Copy to .env.local for local work. Real values live in Vercel's settings,
# never in this repo.

# Supabase: Project Settings → API Keys. The publishable key starts
# sb_publishable_ (older projects call it the anon key). Leave both empty to
# run without a database; `pnpm dlx supabase start` prints local values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry: Settings → Projects → toran → Client Keys (DSN). Empty = off.
NEXT_PUBLIC_SENTRY_DSN=

# Anthropic: console.anthropic.com → API Keys. Lets /ops/posters read a
# poster's photo or PDF into events to check (docs/decisions/0018).
# Empty = off; posters are typed up by hand.
ANTHROPIC_API_KEY=
