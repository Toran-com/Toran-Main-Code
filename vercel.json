{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "regions": ["lhr1"],
  "crons": [
    {
      "path": "/api/cron/nightly",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/websites",
      "schedule": "45 2 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "35 6 * * 4"
    },
    {
      "path": "/api/cron/push",
      "schedule": "5 17 * * *"
    },
    {
      "path": "/api/cron/seva",
      "schedule": "40 17 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "50 6 * * 1"
    }
  ]
}
