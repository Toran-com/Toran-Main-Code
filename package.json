    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  }
